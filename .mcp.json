{
  "mcpServers": {
    "fetch": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "mcp/fetch:latest"
      ]
    },
    "codegraphcontext": {
      "command": "codegraphcontext",
      "args": [
        "mcp",
        "start"
      ]
    },
    "idea": {
      "command": "/home/corneil/.local/share/JetBrains/Toolbox/apps/intellij-idea-ultimate/bin/idea",
      "args": [
        "stdioMcpServer"
      ],
      "env": {
        "IJ_MCP_SERVER_PORT": "64342"
      }
    },
    "perplexity": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@perplexity-ai/mcp-server"
      ],
      "env": {
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}"
      }
    }
  }
}
